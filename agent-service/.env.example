# =============================================================================
# Leadwise Agent Service — Environment Variables
# Copy to `agent-service/.env`
# =============================================================================

# OpenAI API Key (for sub-agents & vector embeddings)
OPENAI_API_KEY="sk-..."

# Supabase REST endpoint & Service Role Key (bypasses RLS for backend writes)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="eyJhbGciOi..."

# PostgreSQL direct connection string for LangGraph PostgresSaver checkpointer
# If unset, checkpointer will gracefully fall back to in-memory MemorySaver.
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# Development Workspace UUID (matches supabase/seed.sql)
DEV_WORKSPACE_ID="00000000-0000-0000-0000-000000000001"
