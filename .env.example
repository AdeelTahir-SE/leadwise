# =============================================================================
# Leadwise — Environment Configuration Template
# Copy this file to `.env.local` for Next.js and `.env` for agent-service.
# =============================================================================

# ── Supabase Configuration (Member 2: Database & Backend) ───────────────────
# Obtain these from your Supabase Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Direct PostgreSQL connection string used by LangGraph PostgresSaver checkpointer
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# Development Workspace UUID (matches supabase/seed.sql demo workspace)
DEV_WORKSPACE_ID="00000000-0000-0000-0000-000000000001"

# ── AI Agent Service Bridge ──────────────────────────────────────────────────
# URL of the Python FastAPI sidecar running the LangGraph StateGraph
AGENT_SERVICE_URL="http://localhost:8000"

# ── LLM / Embeddings API Keys (Member 3 & 4) ─────────────────────────────────
OPENAI_API_KEY="sk-..."

# Optional tool APIs (Member 4: Sub-Agents)
# TAVILY_API_KEY="tvly-..."
# HUNTER_API_KEY="..."
# CLEARBIT_API_KEY="..."
